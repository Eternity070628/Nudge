# 复制成仓库根目录的 .env 再改；.env 已在 .gitignore 里，不会被提交。
# 环境变量优先于 .env，所以 PythonAnywhere 上直接用环境变量面板也行。

# ---- 模型（可选）----
# 不配 key 时自动降级成规则抽取器，离线也能跑完整流程
# MAAS_BASE_URL=https://api.deepseek.com
# MAAS_API_KEY=
# MAAS_MODEL=deepseek-flash

# ---- 邮箱验证码（Microsoft Graph）----
# 默认租户 consumers = 个人 Microsoft 账户；公司/学校邮箱改成自己的 tenant id
GRAPH_TENANT_ID=consumers
# 默认值是微软官方发布的公共客户端「Microsoft Graph Command Line Tools」，
# 已允许设备码流，个人账户也能授权；有自己的 Entra 应用就用它覆盖
GRAPH_CLIENT_ID=14d82eec-204b-4c2f-b7e8-296a70dab67e
GRAPH_SENDER=Eternity070628@outlook.com
GRAPH_SCOPES=https://graph.microsoft.com/Mail.Send offline_access
# 跑过一次 python -m app.services.mailer auth 后，令牌存在本机 SQLite；
# 部署到临时文件系统的机器时，把 refresh token 也放进这个变量，启动会自动写入
GRAPH_REFRESH_TOKEN=
# ---- 邮箱验证码（备用通道：SMTP）----
# 学校/企业邮箱自带 SMTP 时用它更省事（北邮学生邮箱后端是腾讯企业邮）。
# MAIL_TRANSPORT=auto：有 SMTP_USER+SMTP_PASS 就走 SMTP，否则退回 Graph。
MAIL_TRANSPORT=auto
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
# 邮箱设置里开启 SMTP 后生成的「客户端专用密码」，不是网页登录密码
SMTP_PASS=
SMTP_SENDER=
SMTP_SENDER_NAME=Nudge
# 主机名与证书不匹配时才设 0
SMTP_VERIFY_TLS=1

# ---- 邮箱验证码（第三条通道：Brevo HTTPS API）----
# 免费主机（如 PythonAnywhere 免费版）禁止出站 SMTP，但 443 通；
# Brevo 走 HTTPS 发信不受封锁影响，免费额度 300 封/天。
# 发件地址必须先在 Brevo 后台 Senders & IP 验证过，否则会报 400。
# MAIL_TRANSPORT=brevo 明确走它；auto 时只要有 key 就优先它。
# MAIL_TRANSPORT=brevo
# BREVO_API_KEY=xkeysib-...
# BREVO_SENDER=
# BREVO_SENDER_NAME=Nudge

# 没有凭据时打开开发模式：验证码回显到页面和日志，并明确标注「未真实发信」
NUDGE_EMAIL_DEV=0
